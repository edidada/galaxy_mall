# PowerShell: $env:E2E_BASE_URL='http://192.168.31.77:30080'
# This file is an example; environment variables are NOT auto-loaded.
E2E_BASE_URL=http://192.168.31.77:30080
E2E_ENV=uat
E2E_BROWSERS=chromium
E2E_AUTH=0
E2E_ALLOW_WRITES=0
E2E_USERNAME=
E2E_PASSWORD=
E2E_PRODUCT_ID=
E2E_SECURITY=0
E2E_ORDER_ID=
E2E_OTHER_USERNAME=
E2E_OTHER_PASSWORD=
E2E_REPORT_DIR=artifacts
# k6 custom inputs: do NOT use native K6_DURATION / K6_VUS (they replace scenarios).
LOAD_DURATION=30s
LOAD_VUS=10
K6_RATE=5
K6_ALLOW_LOAD=0
LOAD_ALLOW_ORDER_WRITES=0
# SSH-only operational scripts; inject at runtime, never commit an actual password.
CLUSTER_SSH_PASSWORD=
# Trace/video may include tokens, credentials and PII. Restricted UAT use only.
E2E_DIAGNOSTICS=0
